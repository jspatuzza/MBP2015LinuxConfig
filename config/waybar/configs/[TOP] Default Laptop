[

// ### Monitor externo (HDMI-A-2) — configuración completa ###
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"output": "HDMI-A-2",
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"hyprland/workspaces#rw",
	"custom/separator#blank",
	"custom/playerctl",
	],

"modules-center": [
	"custom/separator#blank",
	"group/notify",
	"custom/clock",
	"custom/weather",
	"group/modes",
	],

"modules-right": [
	"tray",
	"custom/keyboard",
	"group/audio",
	"group/laptop",
	"network",
	"group/status",
	],
},

// ### Monitor integrado (eDP-1) — sin indicadores de rendimiento ###
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"output": "eDP-1",
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"hyprland/workspaces#rw",
	"custom/separator#blank",
	"custom/playerctl",
	],

"modules-center": [
	"custom/separator#blank",
	"group/notify",
	"custom/clock",
	"custom/weather",
	"custom/nightlight",
	"custom/light_dark",
	"idle_inhibitor",
	"group/brightness",
	],

"modules-right": [
	"tray",
	"custom/keyboard",
	"group/audio",
	"group/laptop",
	"network",
	"group/status",
	],
}

]
